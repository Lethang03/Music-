VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
VITE_MEDIA_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase
DISCORD_TOKEN=
# Optional: application ID is detected after login; blank guild ID registers in joined guilds.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional health HTTP server; PORT supplied by a host also enables it.
DISCORD_HEALTH_ENABLED=false
# PORT=3000
# Optional alternative executable; blank uses ffmpeg-static for the host platform.
FFMPEG_BIN=
